{
  "$defs": {
    "AgentSpec": {
      "properties": {
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "FaultRule": {
      "properties": {
        "action": {
          "enum": [
            "drop",
            "duplicate",
            "delay",
            "drop_rate",
            "partition"
          ],
          "title": "Action",
          "type": "string"
        },
        "delay": {
          "default": 0.0,
          "minimum": 0,
          "title": "Delay",
          "type": "number"
        },
        "groups": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groups"
        },
        "heal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heal"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "nth": {
          "default": 1,
          "minimum": 1,
          "title": "Nth",
          "type": "integer"
        },
        "rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Rate",
          "type": "number"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "action"
      ],
      "title": "FaultRule",
      "type": "object"
    }
  },
  "$id": "https://nandatown.local/schemas/scenario.schema.json",
  "properties": {
    "adaptations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Adaptations",
      "type": "array"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentSpec"
      },
      "title": "Agents",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "faults": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FaultRule"
      },
      "title": "Faults",
      "type": "array"
    },
    "layers": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Layers",
      "type": "object"
    },
    "max_time": {
      "default": 1000.0,
      "title": "Max Time",
      "type": "number"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "plugin_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Plugin Files",
      "type": "array"
    },
    "redact_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Redact Fields",
      "type": "array"
    },
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "validator": {
      "default": "",
      "title": "Validator",
      "type": "string"
    }
  },
  "required": [
    "name",
    "agents"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}
