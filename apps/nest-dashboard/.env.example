# Copy this file to .env.local and fill in your own value.

# Neon Postgres connection string — powers the SkillMD registry (/skills).
# Get one free at https://neon.tech (use the pooled connection string).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Match the secret configured on the repository's existing pull_request webhook.
GITHUB_WEBHOOK_SECRET=""

# Optional: a token with read-only access to this public repository's pull requests.
# Without it, webhook bursts are coalesced to stay within the anonymous API budget.
GITHUB_TOKEN=""
